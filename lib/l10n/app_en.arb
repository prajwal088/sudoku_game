{
  "@@locale": "en",
  
  "appTitle": "Sudoku World",
  "@appTitle": {
    "description": "The main title of the application"
  },

  "playButton": "Play",
  "@playButton": {
    "description": "Button to start the game from the main menu"
  },

  "continueButton": "Continue",
  "@continueButton": {
    "description": "Button to continue an ongoing game level"
  },
  
  "footerText": "Solve puzzles. Train your brain.",
  "@footerText": {
    "description": "game text"
  },

  "worldLockedMessage": "Complete previous world to unlock",
  "@worldLockedMessage": {
    "description": "Message shown when a user tries to access a locked world"
